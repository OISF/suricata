[package]
name = "suricatasc"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
description = "Suricata socket control program"
readme = "README.md"

[[bin]]
name = "suricatasc"

[dependencies]
clap.workspace = true

once_cell.workspace = true

rustyline = { version = "17.0.2" }
rustyline-derive = { version = "~0.11.1" }

thiserror = { version = "2.0.20" }

serde.workspace = true
serde_json = { workspace = true, features = ["preserve_order"] }

# Not used directly by us, but by rustyline.
home = { version = "=0.5.11" }
unicode-segmentation = { version = "=1.13.3" }

# Not used directly by us, but by serde_json.
indexmap = { version = "=2.14.0" }
