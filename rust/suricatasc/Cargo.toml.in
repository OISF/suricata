[package]
name = "suricatasc"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
description = "Suricata socket control program"
readme = "README.md"

[[bin]]
name = "suricatasc"

[dependencies]
clap = { workspace = true }

once_cell = { workspace = true }

# Held at 14 to support Rust 1.75.0.
rustyline = { version = "14.0.0" }
rustyline-derive = { version = "~0.11.1" }

thiserror = { version = "1.0.69" }

serde = { workspace = true }
serde_json = { workspace = true, features = ["preserve_order"] }

# Pinned to support Rust 1.85. Not used directly by us, but by rustyline.
home = { version = "=0.5.11" }

# Pinned to support Rust 1.85. Not used directly by us, but by rustyline.
unicode-segmentation = { version = "=1.13.3" }

# Pinned to support Rust 1.85. Not used directly by us, but by serde_json.
indexmap = { version = "=2.14.2" }
