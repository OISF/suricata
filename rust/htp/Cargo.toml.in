[package]
name = "suricata-htp"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
autobins = false
license-file = "LICENSE"
description = "Security Aware HTP Protocol parsing library"
readme = "README.md"
repository = "https://github.com/OISF/suricata"
keywords = ["parser", "HTTP", "protocol", "network", "api"]
categories = ["parsing", "network-programming"]
include = [
    "Cargo.toml",
    "LICENSE",
    "README.md",
    "src/**/*.rs",
    "cbindgen.toml",
]

[lib]
crate-type = ["staticlib", "rlib", "cdylib"]

[dependencies]
base64.workspace = true
bstr = "1.12.0"
libc.workspace = true
nom = "8.0.0"
lzma-rs.workspace = true
flate2 = { version = "~1.0.35", features = ["zlib-default"], default-features = false }
brotli.workspace = true
zstd.workspace = true
lazy_static.workspace = true
time = "~0.3.41"

[dev-dependencies]
rstest = "0.17.0"

[build-dependencies]
cdylib-link-lines = "0.1.5"
